                    <label for="nome">Nome do Campeonato *</label>
                    <input id="nome" name="nome" type="text" value="<?= $campeonato['nome'] ?? '' ?>" required>
                </div>

                <div>
                    <label for="pais">País (opcional)</label>
                    <input id="pais" name="pais" type="text" value="<?= $campeonato['pais'] ?? '' ?>">
                </div>

                <button type="submit"><?= $campeonato ? 'Atualizar' : 'Cadastrar' ?></button>
            </form>
        </div>
    </main>
</body>
</html>
