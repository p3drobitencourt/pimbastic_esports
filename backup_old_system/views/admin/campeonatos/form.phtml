            <?php if (isset($errorMsg)): ?>
                <div class="feedback feedback-error">
                    <?= htmlspecialchars($errorMsg, ENT_QUOTES, 'UTF-8') ?>
                </div>
            <?php endif; ?>

            <h1><?= $campeonato ? 'Editar' : 'Novo' ?> Campeonato</h1>

            <form method="post" action="?action=<?= $campeonato ? 'update&id=' . $campeonato['id'] : 'store' ?>" class="form-grid">
