</main>

<script>
    function selectOdd(btn, oddValue, tipo) {
        const form = btn.closest('form');
        // Remove active de todos
        form.querySelectorAll('.odds-row button').forEach(b => b.classList.remove('active'));
        // Adiciona active no clicado
        btn.classList.add('active');
        // Injeta os valores pro POST
        form.querySelector('.tipo-input').value = tipo;
        form.querySelector('.odd-input').value = oddValue;
        // Libera o botão de submit apenas após uma odd ser selecionada
        form.querySelector('.btn-bet').classList.add('enabled');
    }

    function validarAposta(form) {
        if (!form.querySelector('.tipo-input').value) {
            alert("Ação inválida. Selecione uma Odd (Casa, Empate ou Fora) antes de apostar.");
            return false;
        }
        return true;
    }
</script>

